{
  "name": "openclawdemo",
  "version": "1.0.0",
  "description": "OpenClaw Demo Project - A demonstration project for OpenClaw platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:clean": "jest --clearCache",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "openclaw",
    "demo",
    "javascript",
    "web",
    "frontend"
  ],
  "author": "周杰 <18481166081@163.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhoujie2001/openClawDemo.git"
  },
  "bugs": {
    "url": "https://github.com/zhoujie2001/openClawDemo/issues"
  },
  "homepage": "https://zhoujie2001.github.io/openClawDemo/",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/jest": "^29.5.11",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-react": "^7.33.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.1.0",
    "vite": "^8.0.1"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
